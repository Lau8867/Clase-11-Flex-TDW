                            </ol>
                            </div>
                            <div Class="Imagen-trofeo">
                                <img src="./img/PizzaFalling.jpg" alt=""Trofeo de pizza">
                            </div>           
                         </div>
                </div>
        </section>
    </main>

    <footer Class=""footer">
    <ul class="footer-links">
        <li><a href="#"> Home</a></li>
         <li><a href="#">Contacto</a></li>
          <li><a href="#">Ranking</a></li>
