<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pizza-Delivery</title>
    <link rel="stylesheet" href="./css/style.css" />
  </head>
  <body>
    <header>
      <div class="logo">
        <img src=".img/Img/VectorPizza.jpg" alt="Pizza&Front" />
      </div>
      <nav class="nav">
        <a href="#"> Home</a>
        <a href="#"> Ranking</a>
        <a href="#"> Promoción</a>
        <a href="#"> Contacto</a>
      </nav>
